# Claude Code local settings
.claude/

# All Markdown files stay strictly local — no docs/plans ever push to GitHub.
# (.gitignore itself is not .md so this rule does not ignore itself.)
*.md
!README.md

# Data directories (large binary files — only top-level)
/data/

# Model weights and checkpoints (top-level only — src/models/ is code, keep that)
/models/
/models-archive/
/checkpoints/

# Python cache
__pycache__/
*.pyc
*.pyo

# Notebook outputs
notebooks/smoke_test_output/
notebooks/*.html
.ipynb_checkpoints/

# Training artifacts
runs/
experiments/
training_phase*.log
diagnostic_results.txt

# v3 archive — kept locally, not committed
urbanjepa_archive.zip

# Editor/OS
.DS_Store
.vscode/
*.swp
